{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "rpg:npc",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "steve": "textures/entity/steve",
        "alex": "textures/entity/alex",
        "knight": "textures/entity/rpg_npc/knight",
        "merchant": "textures/entity/rpg_npc/merchant",
        "mage": "textures/entity/rpg_npc/mage",
        "cleric": "textures/entity/rpg_npc/cleric",
        "smith": "textures/entity/rpg_npc/smith",
        "guard": "textures/entity/rpg_npc/guard",
        "custom_1": "textures/entity/rpg_npc/custom_1",
        "custom_2": "textures/entity/rpg_npc/custom_2",
        "custom_3": "textures/entity/rpg_npc/custom_3",
        "custom_4": "textures/entity/rpg_npc/custom_4"
      },
      "geometry": {
        "wide": "geometry.humanoid.custom",
        "slim": "geometry.humanoid.customSlim"
      },
      "animations": {
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack": "animation.humanoid.attack.rotations",
        "talk": "animation.rpg_npc.talk",
        "wave": "animation.rpg_npc.wave",
        "cross_arms": "animation.rpg_npc.cross_arms",
        "sit": "animation.rpg_npc.sit",
        "point": "animation.rpg_npc.point",
        "think": "animation.rpg_npc.think",
        "cheer": "animation.rpg_npc.cheer",
        "guard": "animation.rpg_npc.guard",
        "bow": "animation.rpg_npc.bow",
        "dance": "animation.rpg_npc.dance"
      },
      "scripts": {
        "pre_animation": [
          "v.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.attack_time = q.attack_time;"
        ],
        "initialize": [
          "v.gliding_speed_value = 1.0;"
        ],
        "animate": [
          "look_at_target",
          {
            "move": "q.modified_move_speed > 0.01"
          },
          {
            "attack": "v.attack_time > 0"
          },
          {
            "talk": "q.property('rpg:talk')"
          },
          {
            "wave": "q.property('rpg:anim') == 1"
          },
          {
            "cross_arms": "q.property('rpg:anim') == 2"
          },
          {
            "sit": "q.property('rpg:anim') == 3"
          },
          {
            "point": "q.property('rpg:anim') == 4"
          },
          {
            "think": "q.property('rpg:anim') == 5"
          },
          {
            "cheer": "q.property('rpg:anim') == 6"
          },
          {
            "guard": "q.property('rpg:anim') == 7"
          },
          {
            "bow": "q.property('rpg:anim') == 8"
          },
          {
            "dance": "q.property('rpg:anim') == 9"
          }
        ]
      },
      "render_controllers": [
        "controller.render.rpg_npc"
      ],
      "spawn_egg": {
        "base_color": "#181c2e",
        "overlay_color": "#d6ac52"
      }
    }
  }
}