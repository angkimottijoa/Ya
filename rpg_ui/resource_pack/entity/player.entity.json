     },
     {
      "rpgw_fp_hundun_scythe": "variable.is_first_person && query.get_equipped_item_name == 'hundun_scythe'"
     },
     {
      "rpgw_fp_cheongryong_lance": "variable.is_first_person && query.get_equipped_item_name == 'cheongryong_sword'"
