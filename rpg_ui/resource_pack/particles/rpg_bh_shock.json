   },
   "minecraft:emitter_shape_disc": {
    "radius": 0.4,
    "plane_normal": "y",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.5 + variable.particle_random_2 * 0.3"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.9 + variable.particle_random_1 * 0.2)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     "variable.particle_random_4 * 1.5",
     0
    ],
    "linear_drag_coefficient": 2.2
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.12 + variable.particle_random_3 * 0.08) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.7)",
     "variable.size * (0.12 + variable.particle_random_3 * 0.08) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.7)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_2 + (variable.particle_age / variable.particle_lifetime) * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.42": "#FFF2F2F2",
      "0.55": "#FF3A3A3A",
      "0.75": "#FF141414",
      "1.0": "#FF000000"
     }
    }
   }
  }
 }
}