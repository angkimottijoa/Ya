{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:qq_feather",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_qq"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * 2 * variable.r",
     "(variable.particle_random_2 - 0.5) * 2 * variable.r",
     "(variable.particle_random_3 - 0.5) * 2 * variable.r"
    ],
    "direction": [
     "variable.vd.x + (variable.particle_random_1 - 0.5) * variable.h",
     "variable.vd.y + (variable.particle_random_2 - 0.5) * variable.h",
     "variable.vd.z + (variable.particle_random_3 - 0.5) * variable.h"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.85 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:particle_initial_speed": "variable.vs * (0.85 + variable.particle_random_4 * 0.3)",
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.13",
     "variable.size * 0.32"
    ],
    "facing_camera_mode": "lookat_direction",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    },
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.05
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(0.45 + variable.particle_random_4 * 0.4 + (variable.particle_age / variable.particle_lifetime) * 0.15, 0, 1)",
     "gradient": {
      "0.0": "#FFFFE0E0",
      "0.18": "#FFFF6A6A",
      "0.4": "#FFD01A2A",
      "0.65": "#FF6A0A18",
      "0.85": "#FF200408",
      "1.0": "#E0000000"
     }
    }
   }
  }
 }
}