{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:cr_spiral",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.n",
    "max_particles": 1200
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "variable.life"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.35 + variable.particle_random_4 * 0.25"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.particle_random_2 * variable.h * 40 + variable.emitter_age * variable.spin + math.floor(variable.particle_random_1 * 3) * 120)) * (variable.r * (0.55 + variable.particle_random_2 * 0.45))",
     "variable.particle_random_2 * variable.h",
     "math.sin((variable.particle_random_2 * variable.h * 40 + variable.emitter_age * variable.spin + math.floor(variable.particle_random_1 * 3) * 120)) * (variable.r * (0.55 + variable.particle_random_2 * 0.45))"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_initial_speed": "0.5 + variable.particle_random_3",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 1
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.12 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)",
     "variable.size * (0.12 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_2 * 0.4 + variable.particle_random_3 * 0.3 * 0.72 + (variable.particle_age / variable.particle_lifetime) * 0.15 + (variable.particle_random_1 - 0.5) * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.22": "#FFA6F0FF",
      "0.45": "#FF45C8FF",
      "0.7": "#FF1F8BFF",
      "0.88": "#FF1A3CFF",
      "1.0": "#FF0B1FB0"
     }
    }
   }
  }
 }
}