{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:cr_column",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_disc": {
    "radius": "variable.r",
    "plane_normal": "y",
    "direction": [
     "(variable.particle_random_1 - 0.5) * 0.35",
     1,
     "(variable.particle_random_3 - 0.5) * 0.35"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.9 + variable.particle_random_2 * 0.7"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.45 + variable.particle_random_2 * 0.55)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -14,
     0
    ],
    "linear_drag_coefficient": 0.6
   },
   "minecraft:particle_motion_collision": {
    "collision_radius": 0.1,
    "expire_on_contact": true
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.15 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)",
     "variable.size * (0.15 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_2 * 0.6 * 0.72 + (variable.particle_age / variable.particle_lifetime) * 0.15 + (variable.particle_random_1 - 0.5) * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.22": "#FFA6F0FF",
      "0.45": "#FF45C8FF",
      "0.7": "#FF1F8BFF",
      "0.88": "#FF1A3CFF",
      "1.0": "#FF0B1FB0"
     }
    }
   }
  }
 }
}