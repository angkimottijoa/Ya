{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:bh_boomwave",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/rpg_bh_boom"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.n",
    "max_particles": 600
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "variable.dur"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.particle_random_1 * 360)) * (variable.r + variable.emitter_age * variable.spd)",
     "variable.particle_random_2 * 0.6 * variable.size",
     "math.sin((variable.particle_random_1 * 360)) * (variable.r + variable.emitter_age * variable.spd)"
    ],
    "direction": [
     "math.cos((variable.particle_random_1 * 360)) * 0.3",
     "1",
     "math.sin((variable.particle_random_1 * 360)) * 0.3"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.6 + variable.particle_random_2 * 0.6)"
   },
   "minecraft:particle_initial_speed": "0.8 + variable.particle_random_1 * 1.5",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     1,
     0
    ],
    "linear_drag_coefficient": 3
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.6 + variable.particle_random_3 * 0.7) * (0.75 + (variable.particle_age / variable.particle_lifetime) * 0.4)",
     "variable.size * (0.6 + variable.particle_random_3 * 0.7) * (0.75 + (variable.particle_age / variable.particle_lifetime) * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 16,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      16,
      16
     ],
     "flipbook": {
      "base_UV": [
       0,
       0
      ],
      "size_UV": [
       16,
       16
      ],
      "step_UV": [
       16,
       0
      ],
      "max_frame": 8,
      "stretch_to_lifetime": true
     }
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "(1 - math.clamp(variable.tone + (variable.particle_random_4 - 0.5) * 0.25, 0, 1) * 0.86)",
     "(1 - math.clamp(variable.tone + (variable.particle_random_4 - 0.5) * 0.25, 0, 1) * 0.86)",
     "(1 - math.clamp(variable.tone + (variable.particle_random_4 - 0.5) * 0.25, 0, 1) * 0.86) * 1.02",
     1
    ]
   }
  }
 }
}