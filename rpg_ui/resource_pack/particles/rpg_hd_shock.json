{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:hd_shock",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     0,
     0,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.8 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     "math.cos((variable.particle_random_1 * 360)) * (variable.r * (0.15 + math.sqrt((variable.particle_age / variable.particle_lifetime)) * 0.85) * (variable.particle_random_2 < 0.6 ? 1 : 0.75 + variable.particle_random_3 * 0.2))",
     "(variable.particle_age / variable.particle_lifetime) * (variable.particle_random_4 * 0.6)",
     "math.sin((variable.particle_random_1 * 360)) * (variable.r * (0.15 + math.sqrt((variable.particle_age / variable.particle_lifetime)) * 0.85) * (variable.particle_random_2 < 0.6 ? 1 : 0.75 + variable.particle_random_3 * 0.2))"
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (variable.particle_random_2 < 0.6 ? 0.2 : 0.12) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.5)",
     "variable.size * (variable.particle_random_2 < 0.6 ? 0.2 : 0.12) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.5)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "(math.floor(variable.particle_random_3 * 4) + 3)",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp((variable.particle_random_2 < 0.6 ? 0 : 0.35) + (variable.particle_age / variable.particle_lifetime) * 0.65, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.25": "#FFE0E6F0",
      "0.55": "#FFB4A8D8",
      "0.8": "#FF7A5AA8",
      "1.0": "#FF3A2A5A"
     }
    }
   }
  }
 }
}