{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:wr_spark",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/rpg_wr"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * variable.r",
     "(variable.particle_random_2 - 0.5) * variable.r",
     "(variable.particle_random_3 - 0.5) * variable.r"
    ],
    "direction": [
     "(variable.particle_random_1 - 0.5)",
     "variable.particle_random_2 * 0.8",
     "(variable.particle_random_3 - 0.5)"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.5 + variable.particle_random_4 * 0.6)"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.5 + variable.particle_random_4)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -14,
     0
    ],
    "linear_drag_coefficient": 0.8
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.05",
     "variable.size * 0.14"
    ],
    "facing_camera_mode": "lookat_direction",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    },
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.05
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp((variable.particle_age / variable.particle_lifetime) + variable.particle_random_4 * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFF6C8",
      "0.35": "#FFFFC060",
      "0.7": "#FFF0701C",
      "1.0": "#FF601808"
     }
    }
   }
  }
 }
}