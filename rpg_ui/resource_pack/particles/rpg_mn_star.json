{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:mn_star",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_mn"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * 2 * variable.r",
     "(variable.particle_random_2 - 0.5) * 2 * variable.r",
     "(variable.particle_random_3 - 0.5) * 2 * variable.r"
    ],
    "direction": [
     "(variable.particle_random_1 - 0.5)",
     "(variable.particle_random_2 - 0.3)",
     "(variable.particle_random_3 - 0.5)"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.6 + variable.particle_random_4 * 0.6)"
   },
   "minecraft:particle_initial_speed": "variable.spd * variable.particle_random_4",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0.5,
     0
    ],
    "linear_drag_coefficient": 2.5
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_1 * 90"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.13 * (0.55 + 0.45 * math.sin(variable.particle_age * 900 + variable.particle_random_1 * 360)) * (1 - (variable.particle_age / variable.particle_lifetime))",
     "variable.size * 0.13 * (0.55 + 0.45 * math.sin(variable.particle_age * 900 + variable.particle_random_1 * 360)) * (1 - (variable.particle_age / variable.particle_lifetime))"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "variable.tone > 0.75 ? 0.95 : math.clamp(variable.particle_random_3 * 0.4 + variable.tone, 0, 0.7)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.15": "#FFE6F2FF",
      "0.35": "#FFA8CCFF",
      "0.55": "#FF5E7FD8",
      "0.7": "#FF2C3A86",
      "0.78": "#FF120A1E",
      "0.88": "#FF8A1422",
      "1.0": "#FFFF4A3A"
     }
    }
   }
  }
 }
}