{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_puff",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.55
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.5,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.22 + variable.particle_random_3 * 0.22 * 0.5) * variable.size * (1 - -0.5 * (variable.particle_age / variable.particle_lifetime))",
          "(0.22 + variable.particle_random_3 * 0.22 * 0.5) * variable.size * (1 - -0.5 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_3 * 4) + 3",
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1 - (1 - variable.color.r) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 0.6)",
          "1 - (1 - variable.color.g) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 0.6)",
          "1 - (1 - variable.color.b) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 0.6)",
          "variable.color.a * (1 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}