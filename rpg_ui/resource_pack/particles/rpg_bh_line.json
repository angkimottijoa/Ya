{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:bh_line",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + variable.v.x * math.sin(variable.particle_random_1 * 900 + variable.thick * 77) * 0.18 * variable.h",
     "variable.u.y * variable.particle_random_1 * variable.r + variable.v.y * math.sin(variable.particle_random_1 * 900 + variable.thick * 77) * 0.18 * variable.h",
     "variable.u.z * variable.particle_random_1 * variable.r + variable.v.z * math.sin(variable.particle_random_1 * 900 + variable.thick * 77) * 0.18 * variable.h"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.8 + variable.particle_random_4 * 0.4)"
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.1 + variable.particle_random_3 * 0.06) * (1 - variable.particle_random_1 * 0.6) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.5)",
     "variable.size * (0.1 + variable.particle_random_3 * 0.06) * (1 - variable.particle_random_1 * 0.6) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.5)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.tone + (variable.particle_random_2 - 0.5) * 0.3, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.42": "#FFF2F2F2",
      "0.55": "#FF3A3A3A",
      "0.75": "#FF141414",
      "1.0": "#FF000000"
     }
    }
   }
  }
 }
}