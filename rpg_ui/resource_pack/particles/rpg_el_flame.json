{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:el_flame",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_el"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + (variable.v.x * math.cos((variable.particle_random_3 * 360)) + variable.w.x * math.sin((variable.particle_random_3 * 360))) * (variable.thick * 1 * math.sqrt(variable.particle_random_2))",
     "variable.u.y * variable.particle_random_1 * variable.r + (variable.v.y * math.cos((variable.particle_random_3 * 360)) + variable.w.y * math.sin((variable.particle_random_3 * 360))) * (variable.thick * 1 * math.sqrt(variable.particle_random_2))",
     "variable.u.z * variable.particle_random_1 * variable.r + (variable.v.z * math.cos((variable.particle_random_3 * 360)) + variable.w.z * math.sin((variable.particle_random_3 * 360))) * (variable.thick * 1 * math.sqrt(variable.particle_random_2))"
    ],
    "direction": [
     "variable.u.x",
     "variable.u.y",
     "variable.u.z"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.8 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:particle_initial_speed": "3 * (0.5 + variable.particle_random_4)",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 1.5
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.13 * (0.6 + variable.particle_random_4 * 0.6) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)",
     "variable.size * 0.13 * (0.6 + variable.particle_random_4 * 0.6) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_1 * 0.6 + (variable.particle_age / variable.particle_lifetime) * 0.35 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FFFFF6D0",
      "0.2": "#FFFFC850",
      "0.45": "#FFFF7A1E",
      "0.7": "#FFD0301A",
      "0.88": "#E0601010",
      "1.0": "#80200606"
     }
    }
   }
  }
 }
}