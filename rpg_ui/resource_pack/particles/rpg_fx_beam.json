{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 2400,
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "variable.dir.x * variable.len * math.clamp(variable.emitter_age / 0.1, 0, 1) + math.random(-0.06, 0.06)",
          "variable.dir.y * variable.len * math.clamp(variable.emitter_age / 0.1, 0, 1) + math.random(-0.06, 0.06)",
          "variable.dir.z * variable.len * math.clamp(variable.emitter_age / 0.1, 0, 1) + math.random(-0.06, 0.06)"
        ],
        "direction": [
          "math.random(-1, 1)",
          "math.random(-1, 1)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + variable.particle_random_3 * 0.07 * 0.5) * variable.size * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "(0.07 + variable.particle_random_3 * 0.07 * 0.5) * variable.size * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_3 * 4) + 3",
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1 - (1 - variable.color.r) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.g) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.b) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "variable.color.a * (1 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}