{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:ar_spark",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_ar"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * 2 * variable.r",
     "(variable.particle_random_2 - 0.5) * 2 * variable.r",
     "(variable.particle_random_3 - 0.5) * 2 * variable.r"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.5 + variable.particle_random_4 * 0.7)"
   },
   "minecraft:particle_initial_speed": "variable.spd * variable.particle_random_4",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 2
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_1 * 90"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.14 * (0.5 + 0.5 * math.sin(variable.particle_age * 800 + variable.particle_random_2 * 360)) * (1 - (variable.particle_age / variable.particle_lifetime))",
     "variable.size * 0.14 * (0.5 + 0.5 * math.sin(variable.particle_age * 800 + variable.particle_random_2 * 360)) * (1 - (variable.particle_age / variable.particle_lifetime))"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_3 * 0.4 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.2": "#FFD6F0FF",
      "0.45": "#FF7AB6FF",
      "0.7": "#FF4A5CE0",
      "1.0": "#C0301E8A"
     }
    }
   }
  }
 }
}