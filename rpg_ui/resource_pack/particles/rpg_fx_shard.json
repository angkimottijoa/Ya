{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_shard",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 34
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:emitter_shape_disc": {
        "radius": "variable.radius",
        "plane_normal": "y",
        "direction": [
          "math.random(-0.4, 0.4)",
          1,
          "math.random(-0.4, 0.4)"
        ]
      },
      "minecraft:particle_initial_speed": "5 + math.random(0, 4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -22,
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "coefficient_of_restitution": 0.2,
        "collision_drag": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.144 + variable.particle_random_3 * 0.072) * variable.size * (1 - 0.3 * (variable.particle_age / variable.particle_lifetime))",
          "(0.144 + variable.particle_random_3 * 0.072) * variable.size * (1 - 0.3 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_3 * 2) + 6",
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1 - (1 - variable.color.r) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.g) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.b) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "variable.color.a * (1 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}