{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:hd_gas",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * 2 * variable.r",
     "(variable.particle_random_2 - 0.5) * 2 * variable.r",
     "(variable.particle_random_3 - 0.5) * 2 * variable.r"
    ],
    "direction": [
     "variable.vd.x + (variable.particle_random_1 - 0.5) * 0.5",
     "variable.vd.y + (variable.particle_random_2 - 0.5) * 0.5",
     "variable.vd.z + (variable.particle_random_3 - 0.5) * 0.5"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.6 + variable.particle_random_4 * 0.6)"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.6 + variable.particle_random_4 * 0.6)",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 3.2,
    "linear_acceleration": [
     0,
     0.5,
     0
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.1 + variable.particle_random_4 * 0.08) * (0.7 + math.sqrt((variable.particle_age / variable.particle_lifetime)) * 1.2)",
     "variable.size * (0.1 + variable.particle_random_4 * 0.08) * (0.7 + math.sqrt((variable.particle_age / variable.particle_lifetime)) * 1.2)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "(math.floor(variable.particle_random_3 * 4) + 3)",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp((variable.particle_age / variable.particle_lifetime) * 0.9 + variable.particle_random_2 * 0.1 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.25": "#FFE0E6F0",
      "0.55": "#FFB4A8D8",
      "0.8": "#FF7A5AA8",
      "1.0": "#FF3A2A5A"
     }
    }
   }
  }
 }
}