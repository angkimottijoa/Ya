{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:vfx_ember",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/rpg_spark"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.r",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.6 + variable.particle_random_4 * 0.8"
   },
   "minecraft:particle_initial_speed": "1 + variable.particle_random_3 * 3",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     3,
     0
    ],
    "linear_drag_coefficient": 1.5
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.16 * (0.8 + variable.particle_random_3 * 0.4)",
     "variable.size * 0.16 * (0.8 + variable.particle_random_3 * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 1,
     "texture_height": 1,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.min(1, (variable.particle_age / variable.particle_lifetime) / 0.05) * math.clamp((1 - (variable.particle_age / variable.particle_lifetime)) * 3, 0, 1) * (0.7 + 0.3 * math.sin(variable.particle_age * 900 + variable.particle_random_3 * 360))"
    ]
   }
  }
 }
}