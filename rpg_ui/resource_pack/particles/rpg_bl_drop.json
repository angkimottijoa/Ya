{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:bl_drop",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/rpg_bl"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.particle_random_1 - 0.5) * variable.r",
     "(variable.particle_random_2 - 0.5) * variable.r",
     "(variable.particle_random_3 - 0.5) * variable.r"
    ],
    "direction": [
     "(variable.particle_random_1 - 0.5)",
     "0.4 + variable.particle_random_2 * 0.8",
     "(variable.particle_random_3 - 0.5)"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.6 + variable.particle_random_4 * 0.6)"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.5 + variable.particle_random_4)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -16,
     0
    ]
   },
   "minecraft:particle_motion_collision": {
    "collision_radius": 0.05,
    "expire_on_contact": true
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.08 + variable.particle_random_4 * 0.07)",
     "variable.size * (0.08 + variable.particle_random_4 * 0.07)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(0.2 + variable.particle_random_4 * 0.4 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FFFF6A5A",
      "0.25": "#FFD01E28",
      "0.55": "#FF8A0A16",
      "0.8": "#FF46040A",
      "1.0": "#FF140104"
     }
    }
   }
  }
 }
}