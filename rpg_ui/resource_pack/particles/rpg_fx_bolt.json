{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_bolt",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 3000,
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.08
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.45
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "math.sin(math.clamp(variable.emitter_age / 0.08, 0, 1) * 2200) * 0.35 + math.random(-0.08, 0.08)",
          "variable.len * (1 - math.clamp(variable.emitter_age / 0.08, 0, 1))",
          "math.cos(math.clamp(variable.emitter_age / 0.08, 0, 1) * 1700) * 0.35 + math.random(-0.08, 0.08)"
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0.0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.180 + variable.particle_random_3 * 0.090) * variable.size * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "(0.180 + variable.particle_random_3 * 0.090) * variable.size * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_3 * 2) + 6",
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1 - (1 - variable.color.r) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.g) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "1 - (1 - variable.color.b) * math.min(1, (variable.particle_age / variable.particle_lifetime) * 2.5)",
          "variable.color.a * (1 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}