{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:hm_slab",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/rpg_hm"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + variable.v.x * (variable.particle_random_2 - 0.5) * 2 * variable.h",
     "variable.u.y * variable.particle_random_1 * variable.r + variable.v.y * (variable.particle_random_2 - 0.5) * 2 * variable.h",
     "variable.u.z * variable.particle_random_1 * variable.r + variable.v.z * (variable.particle_random_2 - 0.5) * 2 * variable.h"
    ],
    "direction": [
     "variable.v.x * (variable.particle_random_2 - 0.5) * 0.9",
     1,
     "variable.v.z * (variable.particle_random_2 - 0.5) * 0.9"
    ]
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.7 + variable.particle_random_3 * 0.6)",
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.7 + variable.particle_random_4 * 0.5)"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -22,
     0
    ],
    "linear_drag_coefficient": 0.4
   },
   "minecraft:particle_motion_collision": {
    "collision_radius": 0.12,
    "coefficient_of_restitution": 0.25,
    "collision_drag": 6
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_1 * 360",
    "rotation_rate": "(variable.particle_random_2 - 0.5) * 720"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.28 + variable.particle_random_4 * 0.32)",
     "variable.size * (0.28 + variable.particle_random_4 * 0.32)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [
      "math.floor(variable.particle_random_3 * 2) * 8 + 16",
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.particle_random_4 * 0.6 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FF58665C",
      "0.35": "#FF333D37",
      "0.7": "#FF1A211D",
      "1.0": "#FF0A0D0B"
     }
    }
   }
  }
 }
}