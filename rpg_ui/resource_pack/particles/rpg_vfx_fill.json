{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:vfx_fill",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/rpg_glow"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.r * 8",
    "max_particles": 400
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "variable.life"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.8 + variable.particle_random_4 * 0.6"
   },
   "minecraft:emitter_shape_disc": {
    "radius": "variable.r",
    "plane_normal": "y",
    "offset": [
     0,
     0.1,
     0
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_initial_speed": "0.1 + variable.particle_random_3 * 0.3",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 1
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.9 * (0.8 + variable.particle_random_3 * 0.4)",
     "variable.size * 0.9 * (0.8 + variable.particle_random_3 * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 1,
     "texture_height": 1,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.min(1, (variable.particle_age / variable.particle_lifetime) / 0.4) * math.clamp((1 - (variable.particle_age / variable.particle_lifetime)) * 3, 0, 1)"
    ]
   }
  }
 }
}