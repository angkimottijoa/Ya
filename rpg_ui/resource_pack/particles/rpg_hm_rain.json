{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:hm_rain",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_hm"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.particle_random_1 * 360)) * math.sqrt(variable.r * variable.r + variable.particle_random_2 * (variable.thick * variable.thick - variable.r * variable.r))",
     "variable.h + variable.particle_random_3 * 4",
     "math.sin((variable.particle_random_1 * 360)) * math.sqrt(variable.r * variable.r + variable.particle_random_2 * (variable.thick * variable.thick - variable.r * variable.r))"
    ],
    "direction": [
     "(variable.particle_random_4 - 0.5) * 0.08",
     -1,
     0.03
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.85 + variable.particle_random_4 * 0.3)",
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_motion_collision": {
    "collision_radius": 0.05,
    "expire_on_contact": true
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.05",
     "variable.size * 0.55"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.01
    },
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [
      8,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "variable.particle_random_3",
     "gradient": {
      "0.0": "#FFD8FFB0",
      "0.3": "#FF8FEA60",
      "0.7": "#EE3FA83A",
      "1.0": "#AA1B5A22"
     }
    }
   }
  }
 }
}