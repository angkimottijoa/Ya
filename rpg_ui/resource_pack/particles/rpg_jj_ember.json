{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:jj_ember",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.r",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.5 + variable.particle_random_2 * 0.7)"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.3 + variable.particle_random_1 * 0.7)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     1.8,
     0
    ],
    "linear_drag_coefficient": 3
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.07 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.7)",
     "variable.size * (0.07 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.7)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.tone + (variable.particle_age / variable.particle_lifetime) * 0.8 + (variable.particle_random_4 - 0.5) * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFF8D0",
      "0.2": "#FFFFDC50",
      "0.42": "#FFFF9A1E",
      "0.65": "#FFEB4410",
      "0.85": "#FFA0140A",
      "1.0": "#FF3C0804"
     }
    }
   }
  }
 }
}