{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:vfx_line",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/rpg_glow"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.len * 14 / math.max(0.04, variable.dur)",
    "max_particles": 1000
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "math.max(0.04, variable.dur)"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.85 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.dir.x * variable.len * (math.clamp(variable.emitter_age / math.max(0.04, variable.dur), 0, 1) + (variable.particle_random_1 - 0.5) * 0.03)",
     "variable.dir.y * variable.len * (math.clamp(variable.emitter_age / math.max(0.04, variable.dur), 0, 1) + (variable.particle_random_1 - 0.5) * 0.03)",
     "variable.dir.z * variable.len * (math.clamp(variable.emitter_age / math.max(0.04, variable.dur), 0, 1) + (variable.particle_random_1 - 0.5) * 0.03)"
    ]
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * variable.w * (0.8 + variable.particle_random_3 * 0.4)",
     "variable.size * variable.w * (0.8 + variable.particle_random_3 * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 1,
     "texture_height": 1,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.min(1, (variable.particle_age / variable.particle_lifetime) / 0.05) * math.clamp((1 - (variable.particle_age / variable.particle_lifetime)) * 3, 0, 1)"
    ]
   }
  }
 }
}