{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:mn_line",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/rpg_mn"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + variable.v.x * (variable.particle_random_2 - 0.5) * 0.25 + variable.w.x * (variable.particle_random_3 - 0.5) * 0.25",
     "variable.u.y * variable.particle_random_1 * variable.r + variable.v.y * (variable.particle_random_2 - 0.5) * 0.25 + variable.w.y * (variable.particle_random_3 - 0.5) * 0.25",
     "variable.u.z * variable.particle_random_1 * variable.r + variable.v.z * (variable.particle_random_2 - 0.5) * 0.25 + variable.w.z * (variable.particle_random_3 - 0.5) * 0.25"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.4 + variable.particle_random_1 * 0.6)"
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.13 * (1 - (variable.particle_age / variable.particle_lifetime))",
     "variable.size * 0.13 * (1 - (variable.particle_age / variable.particle_lifetime))"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "variable.tone > 0.75 ? math.clamp(0.8 + variable.particle_random_2 * 0.2, 0.78, 1) : math.clamp(0.1 + variable.particle_random_2 * 0.45 + (variable.particle_age / variable.particle_lifetime) * 0.2, 0, 0.7)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.15": "#FFE6F2FF",
      "0.35": "#FFA8CCFF",
      "0.55": "#FF5E7FD8",
      "0.7": "#FF2C3A86",
      "0.78": "#FF120A1E",
      "0.88": "#FF8A1422",
      "1.0": "#FFFF4A3A"
     }
    }
   }
  }
 }
}