{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:cr_tube",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "(variable.u.x * math.cos((variable.particle_random_1 * 360)) + variable.v.x * math.sin((variable.particle_random_1 * 360))) * (variable.r * math.sqrt(variable.particle_random_2))",
     "(variable.u.y * math.cos((variable.particle_random_1 * 360)) + variable.v.y * math.sin((variable.particle_random_1 * 360))) * (variable.r * math.sqrt(variable.particle_random_2))",
     "(variable.u.z * math.cos((variable.particle_random_1 * 360)) + variable.v.z * math.sin((variable.particle_random_1 * 360))) * (variable.r * math.sqrt(variable.particle_random_2))"
    ],
    "direction": [
     "(variable.u.x * math.cos((variable.particle_random_1 * 360)) + variable.v.x * math.sin((variable.particle_random_1 * 360)))",
     "(variable.u.y * math.cos((variable.particle_random_1 * 360)) + variable.v.y * math.sin((variable.particle_random_1 * 360))) + 0.2",
     "(variable.u.z * math.cos((variable.particle_random_1 * 360)) + variable.v.z * math.sin((variable.particle_random_1 * 360)))"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.7 + variable.particle_random_4 * 0.5)"
   },
   "minecraft:particle_initial_speed": "0.3 + variable.particle_random_3 * 0.8",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     "variable.particle_random_4 > 0.8 ? -5 : 0",
     0
    ],
    "linear_drag_coefficient": 3
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.12 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)",
     "variable.size * (0.12 + variable.particle_random_3 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.8)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 4) + 3",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(math.sqrt(variable.particle_random_2) * 0.72 + (variable.particle_age / variable.particle_lifetime) * 0.15 + (variable.particle_random_1 - 0.5) * 0.2, 0, 1)",
     "gradient": {
      "0.0": "#FFFFFFFF",
      "0.22": "#FFA6F0FF",
      "0.45": "#FF45C8FF",
      "0.7": "#FF1F8BFF",
      "0.88": "#FF1A3CFF",
      "1.0": "#FF0B1FB0"
     }
    }
   }
  }
 }
}