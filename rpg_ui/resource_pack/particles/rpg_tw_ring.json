{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:tw_ring",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/rpg_tw"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.particle_random_1 * 360)) * variable.r",
     0.1,
     "math.sin((variable.particle_random_1 * 360)) * variable.r"
    ],
    "direction": [
     "math.cos((variable.particle_random_1 * 360))",
     "variable.particle_random_3 * 0.4",
     "math.sin((variable.particle_random_1 * 360))"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.8 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:particle_initial_speed": "variable.spd * (0.85 + variable.particle_random_2 * 0.3)",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 1.8
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.18 + variable.particle_random_4 * 0.14) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)",
     "variable.size * (0.18 + variable.particle_random_4 * 0.14) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 32,
     "texture_height": 8,
     "uv": [
      "(variable.particle_random_4 > 0.6 ? 8 : 0)",
      0
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(0.25 + variable.particle_random_4 * 0.4 + (variable.particle_age / variable.particle_lifetime) * 0.3, 0, 1)",
     "gradient": {
      "0.0": "#FFFFE8B0",
      "0.2": "#FFFFA040",
      "0.4": "#FFC0602A",
      "0.6": "#FF7A4A2A",
      "0.8": "#FF3A2A22",
      "1.0": "#FF141010"
     }
    }
   }
  }
 }
}