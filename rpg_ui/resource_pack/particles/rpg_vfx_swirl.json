{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:vfx_swirl",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/rpg_glow"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": 1400,
    "max_particles": 900
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "math.max(0.1, variable.dur)"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.28 + variable.particle_random_3 * 0.12"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.emitter_age * variable.spin + math.floor(variable.particle_random_2 * 3) * 120 + variable.particle_random_1 * 70)) * (variable.r * (0.45 + 0.55 * math.clamp(variable.emitter_age / math.max(0.04, variable.dur), 0, 1)) * (0.9 + variable.particle_random_1 * 0.15))",
     "0.25 + variable.particle_random_3 * 0.5 * variable.h",
     "math.sin((variable.emitter_age * variable.spin + math.floor(variable.particle_random_2 * 3) * 120 + variable.particle_random_1 * 70)) * (variable.r * (0.45 + 0.55 * math.clamp(variable.emitter_age / math.max(0.04, variable.dur), 0, 1)) * (0.9 + variable.particle_random_1 * 0.15))"
    ]
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.3 * (0.8 + variable.particle_random_3 * 0.4)",
     "variable.size * 0.3 * (0.8 + variable.particle_random_3 * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 1,
     "texture_height": 1,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.min(1, (variable.particle_age / variable.particle_lifetime) / 0.05) * math.clamp((1 - (variable.particle_age / variable.particle_lifetime)) * 3, 0, 1)"
    ]
   }
  }
 }
}