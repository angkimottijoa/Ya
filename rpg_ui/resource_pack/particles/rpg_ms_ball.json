{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:ms_ball",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "variable.n / math.max(0.05, variable.dur)",
        "max_particles": "variable.n"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "math.max(0.05, variable.dur)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "(math.sin((math.acos(1 - 2 * variable.particle_random_2))) * math.cos((variable.particle_random_1 * 360))) * variable.r * variable.fx",
          "math.cos((math.acos(1 - 2 * variable.particle_random_2))) * variable.r * variable.fy + variable.oy",
          "(math.sin((math.acos(1 - 2 * variable.particle_random_2))) * math.sin((variable.particle_random_1 * 360))) * variable.r * variable.fz"
        ],
        "direction": [
          "(math.sin((math.acos(1 - 2 * variable.particle_random_2))) * math.cos((variable.particle_random_1 * 360))) * variable.fx",
          "math.cos((math.acos(1 - 2 * variable.particle_random_2))) * variable.fy",
          "(math.sin((math.acos(1 - 2 * variable.particle_random_2))) * math.sin((variable.particle_random_1 * 360))) * variable.fz"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life * (0.8 + variable.particle_random_4 * 0.4)"
      },
      "minecraft:particle_initial_speed": "variable.grow",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "variable.rise",
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * 0.07 * (0.75 + variable.particle_random_3 * 0.5) * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 3))",
          "variable.size * 0.07 * (0.75 + variable.particle_random_3 * 0.5) * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 3))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_4 * 3) + 1",
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          1
        ]
      }
    }
  }
}