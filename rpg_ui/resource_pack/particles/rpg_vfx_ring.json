{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:vfx_ring",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/rpg_glow"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.r * 60",
    "max_particles": 900
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": "variable.life"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.35 + variable.particle_random_4 * 0.2"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "math.cos((variable.particle_random_1 * 360 + variable.emitter_age * 25)) * variable.r * (1 + (variable.particle_random_2 - 0.5) * 0.015)",
     "0.08 + variable.particle_random_2 * 0.12",
     "math.sin((variable.particle_random_1 * 360 + variable.emitter_age * 25)) * variable.r * (1 + (variable.particle_random_2 - 0.5) * 0.015)"
    ]
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.45 * (0.8 + variable.particle_random_3 * 0.4)",
     "variable.size * 0.45 * (0.8 + variable.particle_random_3 * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 1,
     "texture_height": 1,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.min(1, (variable.particle_age / variable.particle_lifetime) / 0.2) * math.clamp((1 - (variable.particle_age / variable.particle_lifetime)) * 3, 0, 1) * (0.7 + 0.3 * math.sin(variable.particle_age * 900 + variable.particle_random_3 * 360))"
    ]
   }
  }
 }
}