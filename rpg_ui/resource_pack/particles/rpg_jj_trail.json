{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:jj_trail",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + (variable.particle_random_2 - 0.5) * 0.08 * variable.size",
     "variable.u.y * variable.particle_random_1 * variable.r + (variable.particle_random_2 - 0.5) * 0.08 * variable.size",
     "variable.u.z * variable.particle_random_1 * variable.r + (variable.particle_random_2 - 0.5) * 0.08 * variable.size"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.6 + variable.particle_random_4 * 0.5)"
   },
   "minecraft:particle_initial_speed": "variable.particle_random_3 * 0.4",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     1.2,
     0
    ],
    "linear_drag_coefficient": 2
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * (0.05 + variable.particle_random_1 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)",
     "variable.size * (0.05 + variable.particle_random_1 * 0.07) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 2) + 6",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp((1 - variable.particle_random_1) * 0.75 + (variable.particle_age / variable.particle_lifetime) * 0.5 + variable.tone, 0, 1)",
     "gradient": {
      "0.0": "#FFFFF8D0",
      "0.2": "#FFFFDC50",
      "0.42": "#FFFF9A1E",
      "0.65": "#FFEB4410",
      "0.85": "#FFA0140A",
      "1.0": "#FF3C0804"
     }
    }
   }
  }
 }
}