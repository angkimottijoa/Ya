{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "rpg:hrd_line",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     "variable.u.x * variable.particle_random_1 * variable.r + variable.v.x * math.sin(variable.particle_random_1 * 180) * variable.h",
     "variable.u.y * variable.particle_random_1 * variable.r + variable.v.y * math.sin(variable.particle_random_1 * 180) * variable.h",
     "variable.u.z * variable.particle_random_1 * variable.r + variable.v.z * math.sin(variable.particle_random_1 * 180) * variable.h"
    ],
    "direction": [
     0,
     1,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * (0.85 + variable.particle_random_4 * 0.3)"
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.11 * (1 - variable.particle_random_1 * variable.thick) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.4)",
     "variable.size * 0.11 * (1 - variable.particle_random_1 * variable.thick) * (1 - (variable.particle_age / variable.particle_lifetime) * 0.4)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      "math.floor(variable.particle_random_3 * 2) + 6",
      0
     ],
     "uv_size": [
      1,
      1
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "interpolant": "math.clamp(variable.tone + variable.particle_random_1 * variable.spd + (variable.particle_random_2 - 0.5) * 0.12, 0, 1)",
     "gradient": {
      "0.0": "#FFD3BCE6",
      "0.12": "#FFCFB8E1",
      "0.3": "#FF764995",
      "0.5": "#FF62258C",
      "0.7": "#FF501678",
      "0.86": "#FF390D57",
      "1.0": "#FF1F0631"
     }
    }
   }
  }
 }
}