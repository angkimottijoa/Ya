{
  "namespace": "hud",

  // Arcania HUD 수정 (V2.3)
  //  - 바닐라 하트/갑옷 숨김 → rpg_hud.status_bar (HP/MP/Lv)
  //  - "quest:" title 숨김 (HUD 데이터 전용)
  //  - 핫바는 바닐라 그대로 (9번 칸 = 메뉴 버튼, 모양은 textures/ui/hotbar_8)
  //  ※ 실기 확인 결과(V2.0~2.2): 모바일 핫바의 크기·터치 영역은 엔진이 정하고, 터치는 그 영역 안에서만 받는다.
  //    영역 전체를 offset 으로 옮기는 건 되지만 칸을 따로 떼어 다른 곳에 두는 건 불가능.

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "rpg_hud@rpg_hud.root": {}
          }
        ]
      }
    ]
  },
  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "global",
          "binding_name": "#hud_title_text_string",
          "binding_name_override": "#rpg_title_raw"
        }
      },
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "((#rpg_title_raw - 'quest:') = #rpg_title_raw)",
          "target_property_name": "#visible"
        }
      }
    ]
  },
  "hud_actionbar_text": {
    "offset": [
      0,
      "50%-92px"
    ]
  },
  "heart_renderer": {
    "visible": false,
    "bindings": []
  },
  "armor_renderer": {
    "visible": false,
    "bindings": []
  }
}