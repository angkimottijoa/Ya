{
  "namespace": "hud",

  // Arcania HUD 수정 (V2.2)
  //  - 바닐라 하트/갑옷 숨김 → rpg_hud.status_bar (HP/MP/Lv)
  //  - "quest:" title 숨김 (HUD 데이터 전용)
  //  - 핫바 분리 배치: 1~6번 오른쪽 세로 / 7번 메뉴·8번 스킬창 오른쪽 위 / 9번 스킬 오른쪽 아래
  //    iPad 등은 exp_progress_bar_and_hotbar → hotbar_chooser → hotbar_panel 경로를 쓰므로
  //    그 묶음 패널(경험치바+핫바)을 화면 크기로 키우고 rpg_hotbar_layout 으로 교체한다.
  //    (화면 크기 조절형 hotbar_panel_pocket 경로도 같은 배치)

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "rpg_hud@rpg_hud.root": {}
          }
        ]
      }
    ]
  },
  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "global",
          "binding_name": "#hud_title_text_string",
          "binding_name_override": "#rpg_title_raw"
        }
      },
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "((#rpg_title_raw - 'quest:') = #rpg_title_raw)",
          "target_property_name": "#visible"
        }
      }
    ]
  },
  "hud_actionbar_text": {
    "offset": [
      0,
      "50%-92px"
    ]
  },
  "heart_renderer": {
    "visible": false,
    "bindings": []
  },
  "armor_renderer": {
    "visible": false,
    "bindings": []
  },
  "hotbar_panel_pocket": {
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "use_anchored_offset": false,
    "offset": [
      0,
      0
    ],
    "bindings": [],
    "controls": [
      {
        "rpg_hotbar_layout@hud.rpg_hotbar_layout": {}
      }
    ]
  },
  "rpg_slot_window": {
    "type": "panel",
    "$win_size|default": [
      24,
      24
    ],
    "$grid_off|default": [
      0,
      0
    ],
    "$grid_h|default": 216,
    "size": "$win_size",
    "clips_children": true,
    "controls": [
      {
        "grid": {
          "type": "grid",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$grid_off",
          "size": [
            "100%",
            "$grid_h"
          ],
          "grid_dimensions": [
            1,
            9
          ],
          "grid_item_template": "hud.rpg_hotbar_cell_v",
          "collection_name": "hotbar_items"
        }
      }
    ]
  },
  "rpg_hotbar_cell_v@hud.gui_hotbar_grid_item_pocket": {
    "size": [
      "100%",
      "11.111%"
    ],
    "$hotbar_collection_name": "hotbar_items"
  },
  "rpg_hotbar_layout": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "rpg_main_slots@hud.rpg_slot_window": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            -3,
            8
          ],
          "$win_size": [
            24,
            144
          ],
          "$grid_off": [
            0,
            0
          ],
          "$grid_h": 216
        }
      },
      {
        "rpg_inventory_btn": {
          "type": "panel",
          "size": [
            24,
            24
          ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -59,
            3
          ],
          "controls": [
            {
              "hotbar_elipses_panel_right@hud.hotbar_elipses_panel_right_art": {
                "$hotbar_elipses_panel_right_art_size": [
                  "100%",
                  "100%"
                ],
                "$hotbar_elipses_button_size": [
                  "80%",
                  "80%"
                ],
                "$elipses_image_size": [
                  "75%",
                  "75%"
                ]
              }
            }
          ]
        }
      },
      {
        "rpg_skillwin_slot@hud.rpg_slot_window": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -31,
            3
          ],
          "$win_size": [
            24,
            24
          ],
          "$grid_off": [
            0,
            -168
          ],
          "$grid_h": 216
        }
      },
      {
        "rpg_menu_slot@hud.rpg_slot_window": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -3,
            3
          ],
          "$win_size": [
            24,
            24
          ],
          "$grid_off": [
            0,
            -144
          ],
          "$grid_h": 216
        }
      },
      {
        "rpg_skill_slot@hud.rpg_slot_window": {
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -36,
            -46
          ],
          "$win_size": [
            34,
            34
          ],
          "$grid_off": [
            0,
            -272
          ],
          "$grid_h": 306
        }
      }
    ]
  },
  "exp_progress_bar_and_hotbar": {
    "size": [
      "100%",
      "100%"
    ],
    "offset": [
      0,
      0
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {
        "rpg_hotbar_layout@hud.rpg_hotbar_layout": {}
      }
    ]
  }
}