{
  "namespace": "hud",

  // 기본 HUD 에 RPG 메뉴바 + 퀘스트창 + 캐릭터 카드 추가
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "rpg_hud@rpg_hud.root": {} },
          { "rpg_card@rpg_hud.card_root": {} }
        ]
      }
    ]
  },

  // "quest:" 로 시작하는 title 은 화면 중앙에 띄우지 않는다 (퀘스트창 전용)
  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "global",
          "binding_name": "#hud_title_text_string",
          "binding_name_override": "#rpg_title_raw"
        }
      },
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "((#rpg_title_raw - 'quest:') = #rpg_title_raw)",
          "target_property_name": "#visible"
        }
      }
    ]
  },

  // "[CARD]" 로 시작하는 액션바는 화면 중앙에 띄우지 않는다 (캐릭터 카드 전용)
  "hud_actionbar_text": {
    "visible": "(($actionbar_text - '[CARD]') = $actionbar_text)"
  }
}
