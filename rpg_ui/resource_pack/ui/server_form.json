{
  "namespace": "server_form",

  // 화면 열고 닫을 때의 슬라이드/페이드 애니메이션 제거 → 버튼 누를 때 딜레이 감소
  "third_party_server_screen": {
    "$screen_animations": [],
    // V12.157 HUD 버튼: 폼이 떠 있어도 걷기 · 시점 · 공격이 되게 (모든 메뉴 창에 같이 적용)
    "absorbs_input": false,
    "render_game_behind": true,
    "is_showing_menu": false,
    "should_steal_mouse": false,
    "close_on_player_hurt": false,
    "force_render_below": true
  },

  // 서버 폼(ActionFormData)을 RPG 라우터로 보낸다.
  // 제목에 [RPG:*] 플래그가 없으면 바닐라 레이아웃 그대로(텍스처만 테마 적용).
  "main_screen_content": {
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@rpg_form.router",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  }
}
