{
  "namespace": "server_form",

  // 서버 폼(ActionFormData)을 RPG 라우터로 보낸다.
  // 제목에 [RPG:*] 플래그가 없으면 바닐라 레이아웃 그대로(텍스처만 테마 적용).
  "main_screen_content": {
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@rpg_form.router",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  }
}
