{
  "namespace": "rpg_hud",

  // ════════════════════════════════════════════════════════════════
  //  Arcania HUD (V1.7)
  //  - 스크립트: title = "quest:<퀘스트창>", subtitle = "[CARD]<정보>" / "[BAR]<HP·MP·Lv>" 번갈아 전송
  //  - 터치 버튼: 클리핑 상자 안에 바닐라 핫바 칸 버튼(gui_hotbar_slot_button_prototype) 9개를 세로로 넣고
  //    원하는 칸 하나만 상자 안에 보이게 한다 → 그 버튼을 누르면 해당 핫바 칸이 선택되고 스크립트가 감지.
  //      [스킬창] = 7번 칸, 점프 옆 [스킬] = 8번 칸, [메뉴] = 9번 칸
  //  - [정보]/[퀘스트]: 토글의 켜짐 모양 안에 창이 들어 있어 누르면 창이 접힘 (쉬프트+[메뉴]도 가능)
  // ════════════════════════════════════════════════════════════════

  "root": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 20,
    "$quest_prefix": "quest:",
    "$card_prefix": "[CARD]",
    "$bar_prefix": "[BAR]",
    "controls": [
      {
        "rpg_quest_data@rpg_hud.data_control": {
          "$src": "#hud_title_text_string",
          "$pre": "quest:"
        }
      },
      {
        "rpg_card_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[CARD]"
        }
      },
      {
        "rpg_bar_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[BAR]"
        }
      },
      {
        "rpg_status@rpg_hud.status_bar": {}
      },
      {
        "rpg_right": {
          "type": "panel",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -4,
            4
          ],
          "size": [
            150,
            24
          ],
          "controls": [
            {
              "menu_bar@rpg_hud.menu_bar": {}
            }
          ]
        }
      },
      {
        "rpg_skill_cast@rpg_hud.hotbar_btn": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            -92,
            22
          ],
          "$btn_w": 34,
          "$btn_h": 34,
          "$grid_off": [
            0,
            -238
          ],
          "$face": "rpg_hud.skill_cast_face"
        }
      }
    ]
  },
  "data_control": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "$src|default": "#hud_title_text_string",
    "$pre|default": "quest:",
    "property_bag": {
      "#preserved_text": ""
    },
    "bindings": [
      {
        "binding_name": "$src",
        "binding_name_override": "#src"
      },
      {
        "binding_name": "$src",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#src = #preserved_text) and not ((#src - $pre) = #src))",
        "target_property_name": "#visible"
      }
    ]
  },
  "card_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      "100%c + 10px",
      "100%c + 7px"
    ],
    "layer": 1,
    "controls": [
      {
        "text": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            5,
            4
          ],
          "layer": 3,
          "font_scale_factor": 0.75,
          "color": [
            0.96,
            0.95,
            0.9
          ],
          "shadow": true,
          "localize": false,
          "text": "#text",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "rpg_card_data",
              "source_property_name": "(#preserved_text - $card_prefix)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_card_data",
        "source_property_name": "(not ((#preserved_text - $card_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_right",
    "offset": [
      -8,
      -3
    ]
  },
  "quest_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      150,
      "100%c + 6px"
    ],
    "layer": 1,
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100% - 8px",
            "100%c"
          ],
          "offset": [
            0,
            3
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [
            {
              "header": {
                "type": "image",
                "texture": "textures/ui/rpg/header",
                "size": [
                  "100%",
                  14
                ],
                "controls": [
                  {
                    "icon": {
                      "type": "image",
                      "texture": "textures/ui/rpg/icons/quest",
                      "size": [
                        10,
                        10
                      ],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [
                        2,
                        0
                      ],
                      "layer": 2
                    }
                  },
                  {
                    "label": {
                      "type": "label",
                      "text": "§l퀘스트",
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [
                        15,
                        1
                      ],
                      "layer": 2,
                      "color": [
                        1.0,
                        0.8,
                        0.3
                      ],
                      "shadow": true,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "pad": {
                "type": "panel",
                "size": [
                  "100%",
                  3
                ]
              }
            },
            {
              "body": {
                "type": "label",
                "size": [
                  "100% - 4px",
                  "default"
                ],
                "offset": [
                  2,
                  0
                ],
                "layer": 2,
                "font_scale_factor": 0.85,
                "color": [
                  0.95,
                  0.95,
                  0.97
                ],
                "shadow": true,
                "localize": false,
                "text": "#text",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "rpg_quest_data",
                    "source_property_name": "(#preserved_text - $quest_prefix)",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_quest_data",
        "source_property_name": "(not ((#preserved_text - $quest_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "bottom_left",
    "anchor_to": "top_left",
    "offset": [
      -28,
      5
    ]
  },
  "status_bar": {
    "type": "label",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -42
    ],
    "layer": 3,
    "font_scale_factor": 0.8,
    "color": [
      1.0,
      1.0,
      1.0
    ],
    "shadow": true,
    "localize": false,
    "text": "#text",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_bar_data",
        "source_property_name": "(#preserved_text - $bar_prefix)",
        "target_property_name": "#text"
      }
    ],
    "text_alignment": "center"
  },
  "menu_bar": {
    "type": "image",
    "texture": "textures/ui/rpg/bar",
    "size": [
      "100%",
      24
    ],
    "controls": [
      {
        "info_toggle@rpg_hud.panel_toggle": {
          "offset": [
            4,
            0
          ],
          "toggle_name": "rpg_info",
          "$tg_icon": "textures/ui/rpg/icons/profile",
          "$open_content": "rpg_hud.card_popup"
        }
      },
      {
        "quest_toggle@rpg_hud.panel_toggle": {
          "offset": [
            24,
            0
          ],
          "toggle_name": "rpg_questwin",
          "$tg_icon": "textures/ui/rpg/icons/quest",
          "$open_content": "rpg_hud.quest_popup"
        }
      },
      {
        "skillwin_btn@rpg_hud.hotbar_btn": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            -45,
            0
          ],
          "$btn_w": 40,
          "$btn_h": 18,
          "$grid_off": [
            0,
            -108
          ],
          "$face": "rpg_hud.bar_btn_face",
          "$label": "§l스킬",
          "$icon": "textures/ui/rpg/icons/skill"
        }
      },
      {
        "menu_btn@rpg_hud.hotbar_btn": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            -3,
            0
          ],
          "$btn_w": 40,
          "$btn_h": 18,
          "$grid_off": [
            0,
            -144
          ],
          "$face": "rpg_hud.bar_btn_face",
          "$label": "§l메뉴",
          "$icon": "textures/ui/rpg/icons/settings"
        }
      }
    ]
  },
  "toggle_face": {
    "type": "image",
    "$btn_tex|default": "textures/ui/rpg/button_default",
    "$tg_icon|default": "textures/ui/rpg/icons/profile",
    "texture": "$btn_tex",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "$tg_icon",
          "size": [
            10,
            10
          ],
          "layer": 2
        }
      }
    ]
  },
  "toggle_open": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$btn_tex|default": "textures/ui/rpg/button_hover",
    "controls": [
      {
        "face@rpg_hud.toggle_face": {}
      },
      {
        "content@$open_content": {}
      }
    ]
  },
  "panel_toggle": {
    "type": "toggle",
    "size": [
      18,
      18
    ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "layer": 4,
    "$open_content|default": "rpg_hud.card_popup",
    "toggle_default_state": true,
    "radio_toggle_group": false,
    "focus_enabled": false,
    "sound_name": "random.click",
    "sound_volume": 0.6,
    "checked_control": "checked",
    "unchecked_control": "unchecked",
    "checked_hover_control": "checked_hover",
    "unchecked_hover_control": "unchecked_hover",
    "checked_locked_control": "checked",
    "unchecked_locked_control": "unchecked",
    "checked_locked_hover_control": "checked_hover",
    "unchecked_locked_hover_control": "unchecked_hover",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_ok",
        "mapping_type": "focused"
      }
    ],
    "controls": [
      {
        "checked@rpg_hud.toggle_open": {}
      },
      {
        "checked_hover@rpg_hud.toggle_open": {}
      },
      {
        "unchecked@rpg_hud.toggle_face": {
          "$btn_tex": "textures/ui/rpg/button_pressed"
        }
      },
      {
        "unchecked_hover@rpg_hud.toggle_face": {
          "$btn_tex": "textures/ui/rpg/button_default"
        }
      }
    ]
  },
  "hotbar_btn": {
    "type": "panel",
    "$btn_w|default": 40,
    "$btn_h|default": 18,
    "$grid_off|default": [
      0,
      0
    ],
    "$face|default": "rpg_hud.bar_btn_face",
    "$label|default": "",
    "$icon|default": "textures/ui/rpg/icons/skill",
    "size": [
      "$btn_w",
      "$btn_h"
    ],
    "layer": 6,
    "controls": [
      {
        "face@$face": {}
      },
      {
        "clip": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "clips_children": true,
          "layer": 8,
          "controls": [
            {
              "grid": {
                "type": "grid",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": "$grid_off",
                "size": [
                  "100%",
                  "900%"
                ],
                "grid_dimensions": [
                  1,
                  9
                ],
                "grid_item_template": "rpg_hud.hit_cell",
                "collection_name": "hotbar_items"
              }
            }
          ]
        }
      }
    ]
  },
  "hit_cell": {
    "type": "panel",
    "size": [
      "100%",
      "11.111%"
    ],
    "$hotbar_collection_name": "hotbar_items",
    "controls": [
      {
        "btn@hud.gui_hotbar_slot_button_prototype": {
          "size": [
            "100%",
            "100%"
          ]
        }
      }
    ]
  },
  "bar_btn_face": {
    "type": "image",
    "texture": "textures/ui/rpg/button_default",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "$icon",
          "size": [
            10,
            10
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            4,
            0
          ],
          "layer": 2
        }
      },
      {
        "label": {
          "type": "label",
          "text": "$label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            16,
            1
          ],
          "layer": 2,
          "color": [
            0.97,
            0.87,
            0.58
          ],
          "shadow": true,
          "localize": false
        }
      }
    ]
  },
  "skill_cast_face": {
    "type": "image",
    "texture": "textures/ui/rpg/skill_btn",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "textures/ui/rpg/icons/skill",
          "size": [
            16,
            16
          ],
          "offset": [
            0,
            -3
          ],
          "layer": 2
        }
      },
      {
        "label": {
          "type": "label",
          "text": "§l스킬",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            -3
          ],
          "font_scale_factor": 0.7,
          "layer": 2,
          "color": [
            0.85,
            0.93,
            1.0
          ],
          "shadow": true,
          "localize": false
        }
      }
    ]
  }
}