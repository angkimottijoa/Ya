{
  "namespace": "rpg_hud",

  // ─────────────────────────────────────────────
  //  공통 값
  // ─────────────────────────────────────────────
  "$panel_width": 150,
  "$quest_prefix": "quest:",

  // ─────────────────────────────────────────────
  //  루트: 화면 우측 상단에 메뉴바 + 그 아래 퀘스트창
  // ─────────────────────────────────────────────
  "root": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -4, 4 ],
    "size": [ "$panel_width", "100%c" ],
    "layer": 20,
    "controls": [
      { "menu_bar@rpg_hud.menu_bar": {} },
      { "gap": { "type": "panel", "size": [ "100%", 3 ] } },
      { "quest_window@rpg_hud.quest_window": {} }
    ]
  },

  // ─────────────────────────────────────────────
  //  메뉴바
  // ─────────────────────────────────────────────
  "menu_bar": {
    "type": "image",
    "texture": "textures/ui/rpg/bar",
    "size": [ "100%", 22 ],
    "controls": [
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 7, 0 ],
          "text": "§l§6A R C A N I A",
          "color": [ 0.94, 0.84, 0.55 ],
          "shadow": true,
          "font_type": "smooth",
          "localize": false
        }
      },
      {
        "menu_button@rpg_hud.menu_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [ -3, 0 ]
        }
      }
    ]
  },

  // 메뉴 설정 버튼 (기본 / 호버 / 눌림 3상태)
  "menu_button_face": {
    "type": "image",
    "$btn_tex|default": "textures/ui/rpg/button_default",
    "texture": "$btn_tex",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "textures/ui/rpg/icon_menu",
          "size": [ 10, 10 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 4, 0 ]
        }
      },
      {
        "label": {
          "type": "label",
          "text": "메뉴",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 16, 0 ],
          "color": [ 0.94, 0.84, 0.55 ],
          "shadow": true,
          "font_type": "smooth",
          "localize": false
        }
      }
    ]
  },

  "menu_button@common.button": {
    "size": [ 40, 16 ],
    "focus_enabled": false,
    // HUD 버튼은 터치/커서 입력만 받는다. 실제 메뉴 폼은
    // behavior_pack/scripts/main.js 가 띄운다 (README 참고).
    "$pressed_button_name": "button.rpg_menu",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      { "default@rpg_hud.menu_button_face": { "$btn_tex": "textures/ui/rpg/button_default" } },
      { "hover@rpg_hud.menu_button_face": { "$btn_tex": "textures/ui/rpg/button_hover" } },
      { "pressed@rpg_hud.menu_button_face": { "$btn_tex": "textures/ui/rpg/button_pressed" } }
    ]
  },

  // ─────────────────────────────────────────────
  //  퀘스트창
  //  스크립트/커맨드가 "quest:" 로 시작하는 title 을 보내면
  //  그 내용을 저장해 두고 여기 표시한다. (기본 title 은 숨김)
  // ─────────────────────────────────────────────
  "quest_window": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [ "100%", "100%c + 6px" ],
    "controls": [
      { "data@rpg_hud.quest_data_control": {} },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100% - 8px", "100%c" ],
          "offset": [ 0, 3 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            { "header@rpg_hud.quest_header": {} },
            { "pad": { "type": "panel", "size": [ "100%", 3 ] } },
            { "body@rpg_hud.quest_body": {} }
          ]
        }
      }
    ],
    // 저장된 퀘스트 내용이 비어 있으면 창 자체를 숨긴다
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "data",
        "source_property_name": "(not ((#preserved_text - $quest_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ]
  },

  "quest_header": {
    "type": "image",
    "texture": "textures/ui/rpg/header",
    "size": [ "100%", 13 ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "textures/ui/rpg/icon_quest",
          "size": [ 10, 10 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 2, 0 ]
        }
      },
      {
        "label": {
          "type": "label",
          "text": "§l퀘스트",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 15, 0 ],
          "color": [ 1.0, 0.77, 0.25 ],
          "shadow": true,
          "font_type": "smooth",
          "localize": false
        }
      }
    ]
  },

  "quest_body": {
    "type": "label",
    "size": [ "100% - 4px", "default" ],
    "offset": [ 2, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "color": [ 0.9, 0.9, 0.95 ],
    "shadow": true,
    "font_type": "smooth",
    "localize": false,
    "text": "#text",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "data",
        "source_property_name": "(#preserved_text - $quest_prefix)",
        "target_property_name": "#text"
      }
    ]
  },

  // title 텍스트가 "quest:" 로 시작할 때만 값을 갱신·보존하는 데이터 컨트롤
  "quest_data_control": {
    "type": "panel",
    "size": [ 0, 0 ],
    "property_bag": {
      "#preserved_text": ""
    },
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $quest_prefix) = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  }
}
