{
  "namespace": "rpg_hud",

  // ════════════════════════════════════════════════════════════════
  //  Arcania HUD (V1.4)
  //  - 스크립트: title = "quest:<퀘스트창>", subtitle = "[CARD]<정보>" / "[BAR]<HP·MP·Lv>" 번갈아 전송
  //  - 데이터 컨트롤은 항상 보이는 루트에 둔다 (숨겨진 부모 안에선 바인딩이 갱신되지 않음)
  //  - [스킬]/[메뉴] 버튼: 바닐라 핫바 칸 버튼(gui_hotbar_slot_button_prototype)을 그대로 쓴다.
  //    9칸을 세로로 쌓고(1열 9행) 1~7번 칸은 화면 위로 밀어내서 8·9번 칸만 보이게 한다.
  //    → 버튼을 누르면 핫바 8/9번 칸이 선택되고 스크립트가 감지해 스킬 / 메뉴 실행
  //  - 접기: HUD 는 토글 입력을 처리하지 않으므로 스크립트가 빈 문자열을 보내 창을 숨긴다 (쉬프트+[메뉴])
  //  - 바닐라 하트는 숨기고 핫바 위에 HP / MP / Lv 긴 바 (hud_screen.json)
  // ════════════════════════════════════════════════════════════════

  "root": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 20,
    "$quest_prefix": "quest:",
    "$card_prefix": "[CARD]",
    "$bar_prefix": "[BAR]",
    "controls": [
      {
        "rpg_quest_data@rpg_hud.data_control": {
          "$src": "#hud_title_text_string",
          "$pre": "quest:"
        }
      },
      {
        "rpg_card_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[CARD]"
        }
      },
      {
        "rpg_bar_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[BAR]"
        }
      },
      {
        "rpg_status@rpg_hud.status_bar": {}
      },
      {
        "rpg_buttons@rpg_hud.slot_buttons": {}
      },
      {
        "rpg_panels": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -48,
            4
          ],
          "size": [
            132,
            "100%c"
          ],
          "controls": [
            {
              "quest_window@rpg_hud.quest_popup": {}
            },
            {
              "gap": {
                "type": "panel",
                "size": [
                  "100%",
                  3
                ]
              }
            },
            {
              "card@rpg_hud.card_popup": {}
            }
          ]
        }
      }
    ]
  },
  "data_control": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "$src|default": "#hud_title_text_string",
    "$pre|default": "quest:",
    "property_bag": {
      "#preserved_text": ""
    },
    "bindings": [
      {
        "binding_name": "$src",
        "binding_name_override": "#src"
      },
      {
        "binding_name": "$src",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#src = #preserved_text) and not ((#src - $pre) = #src))",
        "target_property_name": "#visible"
      }
    ]
  },
  "card_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      "100%",
      "100%c + 7px"
    ],
    "layer": 1,
    "controls": [
      {
        "text": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            5,
            4
          ],
          "layer": 3,
          "font_scale_factor": 0.75,
          "color": [
            0.96,
            0.95,
            0.9
          ],
          "shadow": true,
          "localize": false,
          "text": "#text",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "rpg_card_data",
              "source_property_name": "(#preserved_text - $card_prefix)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_card_data",
        "source_property_name": "(not ((#preserved_text - $card_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "quest_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      "100%",
      "100%c + 6px"
    ],
    "layer": 1,
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100% - 8px",
            "100%c"
          ],
          "offset": [
            0,
            3
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [
            {
              "header": {
                "type": "image",
                "texture": "textures/ui/rpg/header",
                "size": [
                  "100%",
                  14
                ],
                "controls": [
                  {
                    "icon": {
                      "type": "image",
                      "texture": "textures/ui/rpg/icons/quest",
                      "size": [
                        10,
                        10
                      ],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [
                        2,
                        0
                      ],
                      "layer": 2
                    }
                  },
                  {
                    "label": {
                      "type": "label",
                      "text": "§l퀘스트",
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [
                        15,
                        1
                      ],
                      "layer": 2,
                      "color": [
                        1.0,
                        0.8,
                        0.3
                      ],
                      "shadow": true,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "pad": {
                "type": "panel",
                "size": [
                  "100%",
                  3
                ]
              }
            },
            {
              "body": {
                "type": "label",
                "size": [
                  "100% - 4px",
                  "default"
                ],
                "offset": [
                  2,
                  0
                ],
                "layer": 2,
                "font_scale_factor": 0.85,
                "color": [
                  0.95,
                  0.95,
                  0.97
                ],
                "shadow": true,
                "localize": false,
                "text": "#text",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "rpg_quest_data",
                    "source_property_name": "(#preserved_text - $quest_prefix)",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_quest_data",
        "source_property_name": "(not ((#preserved_text - $quest_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "status_bar": {
    "type": "label",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -42
    ],
    "layer": 3,
    "font_scale_factor": 0.8,
    "color": [
      1.0,
      1.0,
      1.0
    ],
    "shadow": true,
    "localize": false,
    "text": "#text",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_bar_data",
        "source_property_name": "(#preserved_text - $bar_prefix)",
        "target_property_name": "#text"
      }
    ],
    "text_alignment": "center"
  },
  "slot_buttons": {
    "type": "grid",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [
      -4,
      -129
    ],
    "size": [
      42,
      171
    ],
    "grid_dimensions": [
      1,
      9
    ],
    "grid_item_template": "rpg_hud.slot_cell",
    "collection_name": "hotbar_items",
    "layer": 5
  },
  "slot_cell": {
    "type": "panel",
    "size": [
      42,
      19
    ],
    "$hotbar_collection_name": "hotbar_items",
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "textures/ui/rpg/button_default",
          "size": [
            40,
            18
          ],
          "layer": 1
        }
      },
      {
        "item_icon@hud.hotbar_hud_item_icon": {
          "size": [
            13,
            13
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            4,
            0
          ],
          "layer": 3
        }
      },
      {
        "sel": {
          "type": "image",
          "texture": "textures/ui/rpg/button_hover",
          "size": [
            40,
            18
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#slot_selected",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "hotbar_items"
            }
          ]
        }
      },
      {
        "hotbar_slot_button@hud.gui_hotbar_slot_button_prototype": {
          "size": [
            40,
            18
          ],
          "layer": 6
        }
      }
    ]
  }
}