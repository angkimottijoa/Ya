  "mission_box": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -74
    ],
    "size": [
      "100%c + 12px",
      15
    ],
    "layer": 2,
    "controls": [
      {
        "t": {
          "type": "label",
          "text": "#text",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            1
          ],
          "layer": 3,
          "size": [
            "default",
            10
          ],
          "font_scale_factor": 0.85,
          "color": [
            0.92,
            0.92,
            0.95
          ],
          "shadow": true,
          "localize": false,
          "bindings": [
            {
