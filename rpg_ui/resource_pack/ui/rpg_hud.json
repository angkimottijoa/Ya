{
  "namespace": "rpg_hud",
  "root": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 20,
    "$quest_prefix": "quest:",
    "$card_prefix": "[CARD]",
    "$bar_prefix": "[BAR]",
    "controls": [
      {
        "rpg_quest_data@rpg_hud.data_control": {
          "$src": "#hud_title_text_string",
          "$pre": "quest:"
        }
      },
      {
        "rpg_card_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[CARD]"
        }
      },
      {
        "rpg_bar_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[BAR]"
        }
      },
      {
        "rpg_mis_data@rpg_hud.data_control": {
          "$src": "#hud_subtitle_text_string",
          "$pre": "[MIS]"
        }
      },
      {
        "rpg_status@rpg_hud.status_bar": {}
      },
      {
        "rpg_right": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -6,
            31
          ],
          "size": [
            150,
            "100%c"
          ],
          "controls": [
            {
              "card@rpg_hud.card_popup": {}
            },
            {
              "gap2": {
                "type": "panel",
                "size": [
                  "100%",
                  2
                ]
              }
            },
            {
              "quest_window@rpg_hud.quest_popup": {}
            }
          ]
        }
      },
      {
        "rpg_mission@rpg_hud.mission_box": {}
      }
    ],
    "$mis_prefix": "[MIS]"
  },
  "data_control": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "$src|default": "#hud_title_text_string",
    "$pre|default": "quest:",
    "property_bag": {
      "#preserved_text": ""
    },
    "bindings": [
      {
        "binding_name": "$src",
        "binding_name_override": "#src"
      },
      {
        "binding_name": "$src",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#src = #preserved_text) and not ((#src - $pre) = #src))",
        "target_property_name": "#visible"
      }
    ]
  },
  "card_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      "100%",
      "100%c + 7px"
    ],
    "layer": 1,
    "controls": [
      {
        "text": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            5,
            4
          ],
          "layer": 3,
          "font_scale_factor": 0.75,
          "color": [
            0.96,
            0.95,
            0.9
          ],
          "shadow": true,
          "localize": false,
          "text": "#text",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "rpg_card_data",
              "source_property_name": "(#preserved_text - $card_prefix)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "rpg_card_data",
        "source_property_name": "(not ((#preserved_text - $card_prefix) = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "quest_popup": {
    "type": "image",
    "texture": "textures/ui/rpg/panel",
    "size": [
      "100%",
      "100%c + 6px"
    ],
    "layer": 1,
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100% - 8px",
            "100%c"
          ],
          "offset": [
            0,
            3
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [
            {
              "header": {
                "type": "image",
                "texture": "textures/ui/rpg/header",
                "size": [
                  "100%",
