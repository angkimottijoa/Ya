{
  // ════════════════════════════════════════════════════════════════
  //  Arcania RPG 메뉴 화면 (서버 폼 ActionFormData 를 완전히 다른 레이아웃으로 그림)
  //
  //  제목(title) 플래그:
  //    [RPG:G] 그리드(배낭/상점)  [RPG:H] 타일(홈)  [RPG:L] 리스트  [RPG:D] NPC 대화창  [RPG:F] 연성소(강화, ui/rpg_forge.json)
  //
  //  버튼 텍스트 마커 (스크립트 ui.js 가 붙임):
  //    [I] 본문 항목  [T] 왼쪽 레일 탭  [C] 상단 재화 칩
  //    [S] 상세 카드 헤더(이름+큰 아이콘)  [P] 헤더에 내 캐릭터 3D 표시
  //    [A] 상세 카드 하단 액션 버튼  [ON] 선택됨  [R1]~[R5] 희귀도
  //  순서는 반드시 I → T → C → S → A (그리드 빈칸 방지)
  //
  //  주의: 이미지 안의 글자/아이콘은 layer 를 명시해야 배경 위에 그려진다.
  // ════════════════════════════════════════════════════════════════

  "namespace": "rpg_form",
  "marker_image": {
    "type": "image",
    "$marker|default": "[ON]",
    "$tex|default": "textures/ui/rpg/cell_on",
    "texture": "$tex",
    "size": [
      "100%",
      "100%"
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $marker) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "no_marker_image@rpg_form.marker_image": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#form_button_text - $marker) = #form_button_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "btn_icon": {
    "type": "image",
    "size": [
      16,
      16
    ],
    "layer": 5,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "btn_label": {
    "type": "label",
    "text": "#display",
    "layer": 6,
    "color": "$lbl_color",
    "$lbl_color|default": [
      0.96,
      0.94,
      0.9
    ],
    "shadow": "$lbl_shadow",
    "$lbl_shadow|default": true,
    "localize": false,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((((((((((((#form_button_text - '[I]') - '[T]') - '[C]') - '[S]') - '[P]') - '[A]') - '[ON]') - '[R1]') - '[R2]') - '[R3]') - '[R4]') - '[R5]')",
        "target_property_name": "#display"
      }
    ]
  },
  "only_marker": {
    "type": "panel",
    "$marker|default": "[I]",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $marker) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "form_btn@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [
      "100%",
      "100%"
    ],
    "focus_enabled": true,
    "sound_name": "random.click",
    "sound_volume": 0.6,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "mode_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$flag|default": "[RPG:G]",
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - $flag) = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "router": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "vanilla@server_form.long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '[RPG:') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "book@rpg_form.book_screen": {}
      },
      {
        "dialog@rpg_form.dialog_screen": {}
      }
    ]
  },
  "book_screen": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#title_text - '[RPG:') = #title_text)) and ((#title_text - '[RPG:D]') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "dim": {
          "type": "image",
          "texture": "textures/ui/rpg/screen_bg",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 0
        }
      },
      {
        "rail@rpg_form.rail": {}
      },
      {
        "main": {
          "type": "panel",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            40,
            0
          ],
          "size": [
            "100% - 46px",
            "100%"
          ],
          "layer": 1,
          "controls": [
            {
              "top@rpg_form.top_bar": {}
            },
            {
              "body": {
                "type": "panel",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  28
                ],
                "size": [
                  "100%",
                  "100% - 33px"
                ],
                "controls": [
                  {
                    "center": {
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#title_text - '[RPG:F]') = #title_text)",
                          "target_property_name": "#visible"
                        }
                      ],
                      "type": "image",
                      "texture": "textures/ui/rpg/content_bg",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "size": [
                        "100% - 150px",
                        "100%"
                      ],
                      "controls": [
                        {
                          "inner": {
                            "type": "panel",
                            "size": [
                              "100% - 8px",
                              "100% - 8px"
                            ],
                            "layer": 1,
                            "controls": [
                              {
                                "grid_mode@rpg_form.grid_mode": {}
                              },
                              {
                                "tile_mode@rpg_form.tile_mode": {}
                              },
                              {
                                "list_mode@rpg_form.list_mode": {}
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "detail@rpg_form.detail_card": {
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#title_text - '[RPG:F]') = #title_text)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "forge@rpg_forge.forge_body": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "rail": {
    "type": "image",
    "texture": "textures/ui/rpg/rail",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "size": [
      34,
      "100%"
    ],
    "layer": 1,
    "controls": [
      {
        "tabs": {
          "type": "stack_panel",
          "orientation": "vertical",
          "factory": {
            "name": "buttons",
            "control_ids": {
              "button": "@rpg_form.rail_entry"
            }
          },
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_contents",
              "binding_name_override": "#collection_length"
            }
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            5,
            5
          ],
          "size": [
            34,
            "100%c"
          ],
          "layer": 2
        }
      }
    ]
  },
  "rail_entry@rpg_form.only_marker": {
    "$marker": "[T]",
    "size": [
      34,
      20
    ],
    "controls": [
      {
        "btn@rpg_form.rail_btn": {
          "size": [
            18,
            18
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      }
    ]
  },
  "rail_face": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$bg|default": "textures/ui/rpg/tab_default",
    "controls": [
      {
        "bg@rpg_form.no_marker_image": {
          "$marker": "[ON]",
          "$tex": "$bg",
          "layer": 1
        }
      },
      {
        "on@rpg_form.marker_image": {
          "$marker": "[ON]",
          "$tex": "textures/ui/rpg/tab_on",
          "size": [
            26,
            19
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 1
        }
      },
      {
        "icon@rpg_form.btn_icon": {
          "size": [
            12,
            12
          ]
        }
      }
    ]
  },
  "rail_btn@rpg_form.form_btn": {
    "controls": [
      {
        "default@rpg_form.rail_face": {}
      },
      {
        "hover@rpg_form.rail_face": {
          "$bg": "textures/ui/rpg/tab_hover"
        }
      },
      {
        "pressed@rpg_form.rail_face": {
          "$bg": "textures/ui/rpg/tab_on"
        }
      }
    ]
  },
  "top_bar": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      "100%",
      26
    ],
    "controls": [
      {
        "breadcrumb": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            2,
            1
          ],
          "layer": 3,
          "color": [
            0.97,
            0.88,
            0.6
          ],
          "shadow": true,
          "localize": false,
          "text": "#crumb",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((((#title_text - '[RPG:G]') - '[RPG:H]') - '[RPG:L]') - '[RPG:F]')",
              "target_property_name": "#crumb"
            }
          ]
        }
      },
      {
        "right": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "size": [
            "100%c",
            20
          ],
          "layer": 3,
          "controls": [
            {
              "chips": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "factory": {
                  "name": "buttons",
                  "control_ids": {
                    "button": "@rpg_form.chip_entry"
                  }
                },
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_contents",
                    "binding_name_override": "#collection_length"
                  }
                ],
                "size": [
                  "100%c",
                  20
                ]
              }
            },
            {
              "gap": {
                "type": "panel",
                "size": [
                  4,
                  20
                ]
              }
            },
            {
              "close@rpg_form.close_btn": {}
            }
          ]
        }
      }
    ]
  },
  "chip_entry@rpg_form.only_marker": {
    "$marker": "[C]",
    "size": [
      "100%c + 4px",
      20
    ],
    "controls": [
      {
        "chip": {
          "type": "image",
          "texture": "textures/ui/rpg/chip",
          "size": [
            "100%c + 10px",
            16
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 1,
          "controls": [
            {
              "row": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [
                  "100%c",
                  12
                ],
                "layer": 2,
                "controls": [
                  {
                    "icon@rpg_form.btn_icon": {
                      "size": [
                        11,
                        11
                      ]
                    }
                  },
                  {
                    "sp": {
                      "type": "panel",
                      "size": [
                        3,
                        12
                      ]
                    }
                  },
                  {
                    "txt@rpg_form.btn_label": {
                      "size": [
                        "default",
                        10
                      ],
                      "offset": [
                        0,
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "close_face": {
    "type": "image",
    "$bg|default": "textures/ui/rpg/close_default",
    "texture": "$bg",
    "size": [
      20,
      20
    ],
    "controls": [
      {
        "x": {
          "type": "image",
          "texture": "textures/ui/rpg/icons/close",
          "size": [
            12,
            12
          ],
          "color": [
            0.2,
            0.22,
            0.3
          ],
          "layer": 2
        }
      }
    ]
  },
  "close_btn@common.button": {
    "size": [
      20,
      20
    ],
    "$pressed_button_name": "button.menu_exit",
    "controls": [
      {
        "default@rpg_form.close_face": {}
      },
      {
        "hover@rpg_form.close_face": {
          "$bg": "textures/ui/rpg/close_hover"
        }
      },
      {
        "pressed@rpg_form.close_face": {
          "$bg": "textures/ui/rpg/close_hover"
        }
      }
    ]
  },
  "grid_mode@rpg_form.mode_panel": {
    "$flag": "[RPG:G]",
    "controls": [
      {
        "grid": {
          "type": "grid",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            168,
            160
          ],
          "grid_dimensions": [
            6,
            5
          ],
          "grid_item_template": "rpg_form.grid_cell",
          "collection_name": "form_buttons"
        }
      }
    ]
  },
  "grid_cell@rpg_form.only_marker": {
    "$marker": "[I]",
    "size": [
      28,
      32
    ],
    "controls": [
      {
        "btn@rpg_form.cell_btn": {
          "size": [
            26,
            30
          ]
        }
      }
    ]
  },
  "cell_face": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$hover|default": false,
    "controls": [
      {
        "r1@rpg_form.marker_image": {
          "$marker": "[R1]",
          "$tex": "textures/ui/rpg/cell_r1",
          "layer": 1
        }
      },
      {
        "r2@rpg_form.marker_image": {
          "$marker": "[R2]",
          "$tex": "textures/ui/rpg/cell_r2",
          "layer": 1
        }
      },
      {
        "r3@rpg_form.marker_image": {
          "$marker": "[R3]",
          "$tex": "textures/ui/rpg/cell_r3",
          "layer": 1
        }
      },
      {
        "r4@rpg_form.marker_image": {
          "$marker": "[R4]",
          "$tex": "textures/ui/rpg/cell_r4",
          "layer": 1
        }
      },
      {
        "r5@rpg_form.marker_image": {
          "$marker": "[R5]",
          "$tex": "textures/ui/rpg/cell_r5",
          "layer": 1
        }
      },
      {
        "icon@rpg_form.btn_icon": {
          "size": [
            18,
            18
          ],
          "offset": [
            0,
            -4
          ]
        }
      },
      {
        "count@rpg_form.btn_label": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            0
          ],
          "size": [
            "100%",
            8
          ],
          "text_alignment": "center",
          "font_scale_factor": 0.85,
          "$lbl_color": [
            0.18,
            0.2,
            0.28
          ],
          "$lbl_shadow": false
        }
      },
      {
        "on@rpg_form.marker_image": {
          "$marker": "[ON]",
          "$tex": "textures/ui/rpg/cell_on",
          "layer": 8
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/rpg/cell_hover",
          "size": [
            "100%",
            "100%"
          ],
          "visible": "$hover",
          "layer": 9
        }
      }
    ]
  },
  "cell_btn@rpg_form.form_btn": {
    "controls": [
      {
        "default@rpg_form.cell_face": {}
      },
      {
        "hover@rpg_form.cell_face": {
          "$hover": true
        }
      },
      {
        "pressed@rpg_form.cell_face": {
          "$hover": true
        }
      }
    ]
  },
  "tile_mode@rpg_form.mode_panel": {
    "$flag": "[RPG:H]",
    "controls": [
      {
        "grid": {
          "type": "grid",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            224,
            147
          ],
          "grid_dimensions": [
            4,
            3
          ],
          "grid_item_template": "rpg_form.tile_cell",
          "collection_name": "form_buttons"
        }
      }
    ]
  },
  "tile_cell@rpg_form.only_marker": {
    "$marker": "[I]",
    "size": [
