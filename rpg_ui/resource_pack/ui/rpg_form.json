            0.98,
            0.9,
            0.64
          ]
        }
      }
    ]
  },
  "tile_btn@rpg_form.form_btn": {
    "controls": [
      {
        "default@rpg_form.tile_face": {}
      },
      {
        "hover@rpg_form.tile_face": {
          "$bg": "textures/ui/rpg/tile_hover"
        }
      },
      {
        "pressed@rpg_form.tile_face": {
          "$bg": "textures/ui/rpg/tile_pressed"
        }
      }
    ]
