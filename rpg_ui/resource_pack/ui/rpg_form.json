            "100%",
            "100%c"
          ]
        }
      }
    ]
  },
  "list_entry@rpg_form.only_marker": {
    "$marker": "[I]",
    "size": [
      "100%",
      27
    ],
    "controls": [
      {
        "btn@rpg_form.row_btn": {
          "size": [
            "100%",
            25
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      }
    ]
  },
  "row_face": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$bg|default": "textures/ui/rpg/row_default",
    "controls": [
      {
        "bg@rpg_form.no_marker_image": {
          "$marker": "[ON]",
          "$tex": "$bg",
          "layer": 1
