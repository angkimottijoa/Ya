{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "rpg:npc",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "rpg:skin": { "type": "int", "range": [ 0, 11 ], "default": 0, "client_sync": true }
      }
    },
    "components": {
      "minecraft:type_family": { "family": [ "npc", "rpg_npc", "inanimate" ] },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:damage_sensor": { "triggers": [ { "cause": "all", "deals_damage": "no" } ] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:persistent": {},
      "minecraft:movement": { "value": 0 },
      "minecraft:fire_immune": true,
      "minecraft:behavior.look_at_player": { "priority": 1, "look_distance": 8, "probability": 1.0 },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "event": "rpg:talk" },
            "interact_text": "대화하기"
          }
        ]
      }
    },
    "events": {
      "rpg:talk": {}
    }
  }
}
